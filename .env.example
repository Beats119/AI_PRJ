# AutoGrader v2 configuration (copy to .env / export in the shell)

# Ollama (optional; the deterministic pipeline works without it)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Sandbox backend: auto | docker | process
AUTOGRADER_SANDBOX_BACKEND=auto
# Set to 1 to fail closed when docker is selected/required but unavailable
AUTOGRADER_REQUIRE_DOCKER=
# Docker image used by the docker sandbox adapter
AUTOGRADER_DOCKER_IMAGE=gcc:13-bookworm

# App data directory (SQLite db, packages, stored submissions, cache)
AUTOGRADER_DATA_DIR=.autograder-data
